<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atelje Čuljković - Slikarski Atelje</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <!-- Header i Navigacija -->
    <header>
        <nav class="navbar">
            <div class="nav-brand">
                <div class="logo">
                    <span class="logo-line1">ATELJE</span>
                    <span class="logo-line2">ČULJKOVIĆ</span>
                    <span class="logo-line3">A | Č</span>
                </div>
            </div>
            <ul class="nav-menu">
                <li><a href="#home" class="nav-link">Početna</a></li>
                <li><a href="#about" class="nav-link">O Ateljeu</a></li>
                <li><a href="#gallery" class="nav-link">Galerija</a></li>
                <li><a href="#services" class="nav-link">Usluge</a></li>
                <li><a href="#contact" class="nav-link">Kontakt</a></li>
            </ul>
            <div class="hamburger">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
        </nav>
    </header>

    <!-- Hero Sekcija -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>Dobrodošli u Atelje Čuljković</h1>
            <p>Mesto gde se stvara umetnost i budi kreativnost</p>
            <a href="#gallery" class="cta-button">Pogledaj Naše Radove</a>
        </div>
    </section>

    <!-- About Sekcija-->
    <section id="about" class="about">
        <div class="container">
            <h2>O Našem Ateljeu</h2>
            <div class="about-content">
                <div class="about-text">
                    <p>Atelje Čuljković je osnovan sa ciljem da pruži prostor za stvaranje i učenje umetnosti. Naš tim stručnih umetnika vodi različite programe prilagođene svim nivolima znanja.</p>
                    <p>Bavimo se slikarstvom, crtanjem, grafičkim dizajnom i organizacijom umetničkih radionica. Naš atelje je opremljen savremenim materijalima i pruža inspirativnu atmosferu za stvaralaštvo.</p>
                </div>
                <div class="about-image">
                    <img src="images/background.jpg" alt="Radni prostor ateljea">
                </div>
            </div>
        </div>
    </section>

    <!-- Galerija -->
    <section id="gallery" class="gallery">
        <div class="container">
            <h2>Naši Radovi</h2>
            <div class="gallery-grid">
                <div class="gallery-item">
                    <img src="images/artwork1.jpg" alt="Umetničko delo 1" class="gallery-image">
                    <div class="gallery-overlay">
                        <h3>Apstraktna Kompozicija</h3>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="images/artwork2.jpg" alt="Umetničko delo 2" class="gallery-image">
                    <div class="gallery-overlay">
                        <h3>Pejzaž Ulja</h3>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="images/artwork3.jpg" alt="Umetničko delo 3" class="gallery-image">
                    <div class="gallery-overlay">
                        <h3>Portret</h3>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="images/artwork4.jpg" alt="Umetničko delo 4" class="gallery-image">
                    <div class="gallery-overlay">
                        <h3>Moderna Apstrakcija</h3>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sekcija Usluga-->
    <section id="services" class="services">
        <div class="container">
            <h2>Naše Usluge i Cenovnik</h2>
            <div class="table-container">
                <table class="price-table">
                    <thead>
                        <tr>
                            <th>Usluga</th>
                            <th>Trajanje</th>
                            <th>Cena</th>
                            <th>Napomene</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Početni časovi slikanja</td>
                            <td>2 sata</td>
                            <td>2.500 RSD</td>
                            <td>Materijal uključen</td>
                        </tr>
                        <tr>
                            <td>Napredni kurs</td>
                            <td>3 sata</td>
                            <td>3.500 RSD</td>
                            <td>Individualni pristup</td>
                        </tr>
                        <tr>
                            <td>Radionice za decu</td>
                            <td>1.5 sati</td>
                            <td>1.800 RSD</td>
                            <td>Grupni rad (max 8 dece)</td>
                        </tr>
                        <tr>
                            <td>Portret po narudžbini</td>
                            <td>Po dogovoru</td>
                            <td>od 8.000 RSD</td>
                            <td>Besplatna konsultacija</td>
                        </tr>
                        <tr>
                            <td>Konservacija slika</td>
                            <td>Po pregledu</td>
                            <td>od 5.000 RSD</td>
                            <td>Besplatna procena</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Kontakt Sekcija -->
    <section id="contact" class="contact">
        <div class="container">
            <h2>Kontaktirajte Nas</h2>
            <form class="contact-form" id="contactForm">
                <div class="form-group">
                    <label for="name">Ime i prezime:</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="phone">Telefon:</label>
                    <input type="tel" id="phone" name="phone">
                </div>
                <div class="form-group">
                    <label for="service">Interesuje me:</label>
                    <select id="service" name="service">
                        <option value="">Izaberite uslugu</option>
                        <option value="beginner">Početni časovi</option>
                        <option value="advanced">Napredni kurs</option>
                        <option value="kids">Radionice za decu</option>
                        <option value="portrait">Portret po narudžbini</option>
                        <option value="other">Ostalo</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Poruka:</label>
                    <textarea id="message" name="message" rows="5" required></textarea>
                </div>
                <button type="submit" class="submit-btn">Pošalji Poruku</button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-info">
                    <h3>Atelje Čuljković</h3>
                    <p>Ulica Umetnosti 15<br>Beograd, Srbija</p>
                    <p>Email: info@atelje-culjkovic.rs<br>Telefon: +381 11 123 456</p>
                </div>
                <div class="footer-links">
                    <h3>Brzi linkovi</h3>
                    <ul>
                        <li><a href="#home">Početna</a></li>
                        <li><a href="#about">O nama</a></li>
                        <li><a href="#gallery">Galerija</a></li>
                        <li><a href="#contact">Kontakt</a></li>
                    </ul>
                </div>
                <div class="footer-social">
                    <h3>Pratite nas</h3>
                    <div class="social-links">
                        <a href="#" class="social-link">Facebook</a>
                        <a href="#" class="social-link">Instagram</a>
                        <a href="#" class="social-link">YouTube</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Atelje Čuljković. Sva prava zadržana.</p>
            </div>
        </div>
    </footer>

    <script src="js/script.js"></script>
</body>
</html>
